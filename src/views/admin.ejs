<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin · Portal Super Apps</title>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
  <link href="/css/admin.css" rel="stylesheet" />
</head>
<body>
  <nav class="sidebar d-flex flex-column" id="sidebar">
    <a class="brand" href="/admin">
      <span class="brand-icon d-inline-flex align-items-center justify-content-center"><i class="bi bi-grid-fill"></i></span>
      <span>Portal Super Apps</span>
    </a>

    <div class="nav-section">Menu</div>
    <ul class="nav flex-column mb-2">
      <li class="nav-item">
        <a class="nav-link active" href="#" data-section="dashboard">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#" data-section="main">
          <i class="bi bi-image"></i> Banner Utama
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="#" data-section="promotions">
          <i class="bi bi-megaphone"></i> Banner Promosi
        </a>
      </li>
    </ul>

    <div class="nav-section">Akun</div>
    <ul class="nav flex-column mt-auto mb-3">
      <li class="nav-item">
        <a class="nav-link" href="#" id="logout-link">
          <i class="bi bi-box-arrow-left"></i> Keluar
        </a>
      </li>
    </ul>
  </nav>

  <div class="main-wrapper">
    <header class="topbar d-flex align-items-center px-3 px-lg-4 gap-3">
      <button class="btn btn-light border d-lg-none" type="button" id="sidebar-toggle" aria-label="Buka menu">
        <i class="bi bi-list"></i>
      </button>
      <h2 class="page-title h5 mb-0" id="page-title">Dashboard</h2>
      <div class="ms-auto d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success d-none d-sm-inline-flex align-items-center gap-1">
          <i class="bi bi-circle-fill" style="font-size:.5rem"></i> Online
        </span>
        <span class="avatar-chip" id="avatar-chip">A</span>
        <span class="small fw-semibold d-none d-md-inline" id="user-email">admin</span>
      </div>
    </header>

    <main class="p-3 p-lg-4">
      <div id="global-alert" class="alert alert-danger d-none py-2 small" role="alert"></div>

      <!-- Dashboard -->
      <section class="content-section active" id="section-dashboard">
        <div class="row g-3 mb-4">
          <div class="col-sm-6 col-xl-3">
            <div class="card stat-card p-3">
              <div class="d-flex align-items-center gap-3">
                <span class="stat-icon primary"><i class="bi bi-image"></i></span>
                <div>
                  <div class="text-muted small">Banner Utama</div>
                  <div class="fs-4 fw-bold" id="stat-main">–</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="card stat-card p-3">
              <div class="d-flex align-items-center gap-3">
                <span class="stat-icon success"><i class="bi bi-megaphone"></i></span>
                <div>
                  <div class="text-muted small">Banner Promosi</div>
                  <div class="fs-4 fw-bold" id="stat-promo">–</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="card stat-card p-3">
              <div class="d-flex align-items-center gap-3">
                <span class="stat-icon warning"><i class="bi bi-images"></i></span>
                <div>
                  <div class="text-muted small">Total Banner</div>
                  <div class="fs-4 fw-bold" id="stat-total">–</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-sm-6 col-xl-3">
            <div class="card stat-card p-3">
              <div class="d-flex align-items-center gap-3">
                <span class="stat-icon primary"><i class="bi bi-hdd-stack"></i></span>
                <div>
                  <div class="text-muted small">Penyimpanan</div>
                  <div class="fs-6 fw-bold mb-0">Lokal</div>
                  <div class="banner-meta">folder /uploads</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-lg-6">
            <div class="card panel-card">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h3 class="h6 fw-bold mb-0">Pratinjau Banner Utama</h3>
                  <button class="btn btn-sm btn-outline-primary" data-section-link="main">Kelola</button>
                </div>
                <div id="preview-main"></div>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="card panel-card">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h3 class="h6 fw-bold mb-0">Pratinjau Banner Promosi</h3>
                  <button class="btn btn-sm btn-outline-primary" data-section-link="promotions">Kelola</button>
                </div>
                <div id="preview-promo"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Banner Utama -->
      <section class="content-section" id="section-main">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <h2 class="h5 fw-bold mb-1">Banner Utama</h2>
            <p class="text-muted small mb-0">Maksimal 1 banner ditampilkan di halaman utama.</p>
          </div>
          <button class="btn btn-primary" id="btn-add-main">
            <i class="bi bi-plus-lg me-1"></i> Tambah Banner
          </button>
        </div>
        <div class="row g-3" id="list-main"></div>
      </section>

      <!-- Banner Promosi -->
      <section class="content-section" id="section-promotions">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div>
            <h2 class="h5 fw-bold mb-1">Banner Promosi</h2>
            <p class="text-muted small mb-0">Maksimal 3 banner promosi ditampilkan di halaman utama.</p>
          </div>
          <button class="btn btn-primary" id="btn-add-promo">
            <i class="bi bi-plus-lg me-1"></i> Tambah Banner
          </button>
        </div>
        <div class="row g-3" id="list-promo"></div>
      </section>
    </main>
  </div>

  <!-- Modal Banner -->
  <div class="modal fade" id="banner-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <form class="modal-content" id="banner-form" novalidate>
        <div class="modal-header">
          <h2 class="modal-title h5 fw-bold" id="banner-modal-title">Tambah Banner</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="banner-id" />
          <input type="hidden" id="banner-collection" />

          <div class="mb-3">
            <label for="banner-title" class="form-label fw-semibold small">Judul</label>
            <input type="text" class="form-control" id="banner-title" placeholder="Contoh: Promo Gajian" maxlength="120" required />
          </div>
          <div class="mb-3">
            <label for="banner-description" class="form-label fw-semibold small">Deskripsi</label>
            <textarea class="form-control" id="banner-description" rows="3" placeholder="Deskripsi singkat banner" maxlength="500" required></textarea>
          </div>
          <div class="mb-2">
            <label for="banner-image" class="form-label fw-semibold small">Gambar <span class="text-muted fw-normal">(JPG/PNG, maks 2MB)</span></label>
            <input type="file" class="form-control" id="banner-image" accept="image/jpeg,image/png" />
          </div>
          <div id="banner-preview-wrap" class="d-none">
            <img id="banner-preview" class="image-preview mb-2" alt="Pratinjau banner" />
            <div class="banner-meta" id="banner-preview-meta"></div>
          </div>
          <div class="form-text">Kosongkan gambar jika tidak ingin mengubah gambar saat edit.</div>
          <div class="alert alert-danger d-none py-2 small mt-3 mb-0" id="banner-form-alert"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-primary" id="banner-submit">
            <span class="spinner-border spinner-border-sm d-none me-1" id="banner-spinner"></span>
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus -->
  <div class="modal fade" id="delete-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-body text-center p-4">
          <div class="text-danger mb-2"><i class="bi bi-exclamation-triangle-fill" style="font-size:2rem"></i></div>
          <h2 class="h6 fw-bold">Hapus banner ini?</h2>
          <p class="text-muted small">Data dan gambar banner akan dihapus permanen.</p>
          <div class="d-grid gap-2">
            <button class="btn btn-danger" id="confirm-delete">
              <span class="spinner-border spinner-border-sm d-none me-1" id="delete-spinner"></span>
              Ya, hapus
            </button>
            <button class="btn btn-light border" data-bs-dismiss="modal">Batal</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="app-toast" class="toast align-items-center text-bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body" id="app-toast-message"></div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Tutup"></button>
      </div>
    </div>
  </div>

  <div class="offcanvas-backdrop fade d-lg-none" id="sidebar-backdrop" hidden></div>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/auth.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
