PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Kredensial admin awal, hanya dipakai saat menjalankan `npm run seed`.
# Setelah seed, login mengambil akun dari tabel `users`, bukan dari file ini.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

DB_HOST=localhost
DB_PORT=3306
DB_NAME=portalsuperapps
DB_USER=root
DB_PASSWORD=
